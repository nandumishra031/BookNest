<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BookNest" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Prevent fullscreen mode -->
        <item name="android:windowFullscreen">false</item>
        <!-- Show system UI -->
        <item name="android:fitsSystemWindows">true</item>
        <!-- Status bar color that adapts to light theme -->
        <item name="android:statusBarColor">@android:color/white</item>
        <!-- Navigation bar color that adapts to light theme -->
        <item name="android:navigationBarColor">@android:color/white</item>
        <!-- Make status bar icons dark for light theme -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>